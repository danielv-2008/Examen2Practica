<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - TesisGestión</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-sm site-navbar mb-4">
            <div class="container">
                <a class="navbar-brand fw-bold" asp-page="/Index">
                    <span class="brand-icon">🎓</span> Tesis<span class="brand-accent">Gestión</span>
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse"
                        aria-controls="navbarSupportedContent" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1">
                        @if (Context.Session.EstaLogueado())
                        {
                            <li class="nav-item">
                                <a class="nav-link" asp-page="/Tesis/Index">📚 Tesis</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" asp-page="/Tutores/Index">👩‍🏫 Tutores</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" asp-page="/Tesis/Crear">✨ Nueva tesis</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" asp-page="/Tutores/Crear">➕ Nuevo tutor</a>
                            </li>
                        }
                    </ul>
                    <ul class="navbar-nav align-items-sm-center">
                        @if (Context.Session.EstaLogueado())
                        {
                            <li class="nav-item">
                                <span class="nav-link nav-user">👋 Hola, <strong>@Context.Session.ObtenerUsuario()</strong></span>
                            </li>
                            <li class="nav-item ms-sm-2">
                                <a class="btn btn-logout btn-sm" asp-page="/Logout">Salir</a>
                            </li>
                        }
                        else
                        {
                            <li class="nav-item">
                                <a class="btn btn-login btn-sm" asp-page="/Login">🔐 Iniciar sesión</a>
                            </li>
                        }
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <div class="container">
        <main role="main" class="pb-4">
            @RenderBody()
        </main>
    </div>

    <footer class="site-footer">
        <div class="container d-flex flex-wrap justify-content-between align-items-center">
            <span>© 2026 - TesisGestión · Gestión de Tesis y Tutores</span>
            <span class="footer-heart">Hecho con 💜 en magenta</span>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
